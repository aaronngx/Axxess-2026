library(dplyr)
setwd("~/Desktop/Data Analysis/Data")
tae <- read.csv("~/Desktop/Data Analysis/Data/tae.data")
colnames(tae) <- c("english_speaker", "course_instructor", "course", "regular_semester",
"class_size", "class_attribute")
tae$ta_id <- 1:nrow(tae)
View(tae)
tae$english_speaker <- ifelse(tae$english_speaker == "1",
TRUE,
ifelse(tae$english_speaker == "2",
FALSE, NA))
tae$regular_semester <- ifelse(tae$regular_semester == "2",
TRUE,
ifelse(tae$regular_semester == "1",
FALSE, NA))
tae$class_attribute <- factor(tae$class_attribute,
levels = c(1, 2, 3),
labels = c("low", "medium", "high"))
avg_size_reg <- round(mean(subset(tae, regular_semester == TRUE)$class_size), 0)
median_size_reg <- round(median(subset(tae, regular_semester == TRUE)$class_size), 0)
avg_size_summer <- round(mean(subset(tae, regular_semester == FALSE)$class_size), 0)
median_size_summer <- round(median(subset(tae, regular_semester == FALSE)$class_size), 0)
tae_reg <- subset(tae, regular_semester == TRUE)
tae_summer <- subset(tae, regular_semester == FALSE)
summer_english <- length(subset(tae_reg, english_speaker == TRUE)$ta_id)
summer_english <- length(subset(tae_summer, english_speaker == TRUE)$ta_id)
View(tae_reg)
View(tae_summer)
tae_reg <- subset(tae, regular_semester == TRUE)
tae_summer <- subset(tae, regular_semester == FALSE)
regular_english <- length(subset(tae_reg, english_speaker == TRUE)$ta_id)
summer_english <- length(subset(tae_summer, english_speaker == TRUE)$ta_id)
View(tae_reg)
View(tae_summer)
tae_eng <- subset(tae, english_speaker == TRUE)
num_eng <- length(tae_eng$ta_id)
num_high_scores <- length(subset(tae_eng, class_attribute == "high")$ta_id)
high_tae_eng <-  round((num_high_scores / num_eng), 2)
tae_non_eng <- subset(tae, english_speaker == FALSE)
num_non_eng <- length(tae_non_eng$ta_id)
num_non_high_scores <- length(subset(tae_non_eng, class_attribute == "high")$ta_id)
high_tae_non_eng <- round((num_non_high_scores / num_non_eng), 2)
